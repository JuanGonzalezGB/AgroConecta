# Copia este archivo a .env y ajusta lo que necesites.

# Base de datos. Por defecto: SQLite local en data/agroconecta.db
# Para cambiar de motor basta con cambiar esta URL (y instalar su driver), por ejemplo:
#   DATABASE_URL=postgresql+psycopg://usuario:clave@localhost:5432/agroconecta
DATABASE_URL=sqlite:///data/agroconecta.db

# Secreto para firmar los JWT de la API (genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
